  "item": [
    {
      "name": "POST Request",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var random = Math.random().toString(36).substring(2);\r",
              "var email = \"email\"+random+\"@gamil.com\";\r",
              "pm.environment.set(\"env_email\",email);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var JsonData = pm.response.json();\r",
              "pm.environment.set(\"env_id\",JsonData.id);\r",
              "pm.test(\"check status code201\",()=>\r",
              "{\r",
              "    pm.response.to.have.status(201);\r",
              "}\r",
              ");\r",
              "pm.test(\"Check response time below 2 second\",()=>\r",
              "{\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "}\r",
              ");\r",
              "pm.test(\"check data validation \",()=>\r",
              "{\r",
              "    pm.expect(JsonData.id).to.be.a(\"number\");\r",
              "    pm.expect(JsonData.name).to.be.a(\"string\");\r",
              "}\r",
              ");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
