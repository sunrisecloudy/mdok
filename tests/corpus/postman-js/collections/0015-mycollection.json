    {
      "name": "GET All Student Data",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// server कडून आलेला JSON data usable format मध्ये store करतो\r",
              "const jsonData = pm.response.json();\r",
              "// array मध्ये data असायला पाहिजे\r",
              "pm.test(\"array is not empty\",()=>\r",
              "{\r",
              "    pm.expect(jsonData.length).to.be.above(0);\r",
              "});\r",
              "// array मधला पहिला student object असायला पाहिजे\r",
              "pm.test(\"data type check\", ()=>\r",
              "{\r",
              "    pm.expect(jsonData[0].id).to.be.a('string');\r",
              "    pm.expect(jsonData[0].name).to.be.a('string');\r",
              "    pm.expect(jsonData[0].location).to.be.a('string');\r",
              "    pm.expect(jsonData[0].courses).to.be.an('array');\r",
              "}\r",
              ");\r",
              "// courses मध्ये Java आहे का check करतो\r",
              "pm.test(\"Java course check\", ()=>  \r",
              "{\r",
              "    pm.expect(jsonData[0].courses).to.include('Java');\r",
              "});\r",
              "//all student datatype check\r",
              "// सर्व students चा data type check करतो (loop वापरून)\r",
              "pm.test(\"check all student datatype check\", ()=>\r",
              "{\r",
              "jsonData.forEach((students) =>\r",
              "{\r",
              "    pm.expect(students.id).to.be.a('string');\r",
              "    pm.expect(students.name).to.be.a('string');\r",
              "    pm.expect(students.location).to.be.a('string');\r",
              "    pm.expect(students.courses).to.be.an('array');\r",
              "}\r",
              ");\r",
              "}\r",
              ");\r",
              "//// प्रत्येक student चा name empty नाही check करतो\r",
              "pm.test(\"check all student name is not empty\", ()=>\r",
              "{\r",
              "    jsonData.forEach((student)=>\r",
              "    {\r",
              "        pm.expect(student.name).to.not.be.empty;\r",
              "    });\r",
              "});\r",
              "var schema = {\r",
              "    \"type\": \"array\",\r",
              "    \"items\": {\r",
              "        \"type\": \"object\",\r",
              "        \"properties\": {\r",
              "            \"id\": { \"type\": \"string\" },\r",
              "            \"name\": { \"type\": \"string\" },\r",
              "            \"location\": { \"type\": \"string\" },\r",
              "            \"phone\": { \"type\": \"string\" },\r",
              "            \"courses\": {\r",
              "                \"type\": \"array\",\r",
              "                \"items\": { \"type\": \"string\" }\r",
              "            }\r",
              "        },\r",
              "        \"required\": [\"id\", \"name\", \"location\", \"phone\", \"courses\"]\r",
              "    }\r",
              "};\r",
              "var schema = {\r",
              "    \"type\": \"array\",\r",
              "    \"items\": {\r",
              "        \"type\": \"object\",\r",
              "        \"properties\": {\r",
              "            \"id\": { \"type\": \"string\" },\r",
              "            \"name\": { \"type\": \"string\" },\r",
              "            \"location\": { \"type\": \"string\" },\r",
              "            \"phone\": { \"type\": \"string\" },\r",
              "            \"courses\": {\r",
              "                \"type\": \"array\",\r",
              "                \"items\": { \"type\": \"string\" }\r",
              "            }\r",
              "        },\r",
              "        \"required\": [\"id\", \"name\", \"location\", \"phone\", \"courses\"]\r",
              "    }\r",
              "};\r",
              "\r",
              "\r",
              "pm.test(\"Schema is valid\", function ()\r",
              "{\r",
              "    pm.expect(tv4.validate(jsonData, schema)).to.be.true;\r",
              "});\r",
              "// response status code 200 (OK) आहे का check करतो\r",
              "pm.test(\"Status code is 200\",()=>\r",
              "\r",
              "{\r",
              "    pm.response.to.have.status(200);\r",
              "}\r",
              ");"
