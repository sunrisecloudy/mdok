    {
      "name": "GET Single Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\r",
              "    \"Status code is 200\", ()=>\r",
              "    {\r",
              "        pm.response.to.have.status(200);\r",
              "    }\r",
              ");\r",
              "pm.test(\r",
              "    \"successful Get request\",()=>\r",
              "    {\r",
              "        pm.expect(pm.response.code).to.be.oneOf([200,201]);\r",
              "\r",
              "    });\r",
              "    pm.test(\r",
              "        \"content-Type is prestint\", ()=>\r",
              "        {\r",
              "            pm.response.to.have.header(\"content-Type\");\r",
              "        }\r",
              "    );\r",
              "    pm.test(\"content-Type header is application/json\", ()=>\r",
              "    {\r",
              "        pm.expect(pm.response.headers.get(\"content-Type\")).to.eql\r",
              "        (\"application/json\");  \r",
              "    }\r",
              "    );\r",
              "    pm.test(\"response time is less than 200ms\", ()=>\r",
              "    {\r",
              "        pm.expect(pm.response.responseTime).to.be.below(200);\r",
              "    }\r",
              "    );\r",
              "    //test the type of any part of the response\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.test(\"Test data type the response\", ()=>\r",
              "    {\r",
              "        pm.expect(jsonData[0]).to.be.an(\"object\");\r",
              "        pm.expect(jsonData[0].name).to.be.a(\"string\");\r",
              "        pm.expect(jsonData[0].id).to.be.a(\"string\");\r",
              "        pm.expect(jsonData[0].courses).to.be.a(\"array\");\r",
              "        \r",
              "    });\r",
              "    //asserting array properties//test array contains in body\r",
              "    pm.test(\"Test array contains\", ()=>\r",
              "    {\r",
              "        pm.expect(jsonData[0].courses).to.include(\"Java\");\r",
              "        //course array must iclude all listed\r",
              "        pm.expect(jsonData[0].courses).to.have.members([\"Java\",\"Selenium\"]);\r",
              "    }\r",
              "    );\r",
              "    //value are fields//data Validation    \r",
              "    \r",
              "    pm.test(\"Test value of any field\", ()=>\r",
              "    {\r",
              "        \r",
              "        var jsonData = pm.response.json();\r",
              "        pm.expect(jsonData[0].id).to.eql(\"1\");\r",
              "        pm.expect(jsonData[0].name).to.eql(\"John\");\r",
              "        pm.expect(jsonData[0].location).to.eql(\"India\");\r",
              "        pm.expect(jsonData[0].phone).to.eql(\"1234567890\");\r",
              "\r",
              "\r",
              "        \r",
              "    }\r",
              "    );\r",
              "    //json schema Validation\r",
              "    var schema = {\r",
              "    \"type\": \"object\",\r",
              "    \"properties\": {\r",
              "        \"id\": { \"type\": \"string\" },\r",
              "        \"name\": { \"type\": \"string\" },\r",
              "        \"location\": { \"type\": \"string\" },\r",
              "        \"phone\": { \"type\": \"string\" },\r",
              "        \"courses\": {\r",
              "            \"type\": \"array\",\r",
              "            \"items\": {\r",
              "                \"type\": \"string\"\r",
              "            }\r",
              "        }\r",
              "    },\r",
              "    \"required\": [\"id\", \"name\", \"location\", \"phone\", \"courses\"]\r",
              "\r",
              "};\r",
              "pm.test(\"Schema is valid\", function()\r",
              "{\r",
              "    tv4.validate(jsonData[0], schema)\r",
              "}\r",
              "); \r",
              ""
            ],
